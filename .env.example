# URL del servicio que recibe las solicitudes del formulario. En desarrollo,
# si se omite, el formulario simula un envío correcto sin hacer peticiones.
PUBLIC_AUDIT_FORM_ENDPOINT=

# Activar cuando Turnstile esté configurado en el proveedor de formularios.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_SITE_URL=http://localhost:4321
