# Dominio público del sitio (sin barra final ni subruta). Se usa en canonical,
# sitemap, robots.txt, llms.txt y datos estructurados.
# En desarrollo local puedes dejarlo vacío (se usa https://vialengo.com).
PUBLIC_SITE_URL=https://vialengo.com

# Solo si el sitio se sirve desde una subruta, p. ej. /repositorio en GitHub Pages
# sin dominio propio. Con dominio propio, vacío.
PUBLIC_BASE_PATH=

# Email de contacto público. Vacío = no se muestra ninguno.
PUBLIC_CONTACT_EMAIL=

# URL que recibe por POST (FormData) las solicitudes del formulario de auditoría.
# En desarrollo (npm run dev), si se omite, el formulario funciona en MODO SIMULADO
# y lo indica claramente. En producción, si se omite, el formulario NO se muestra.
PUBLIC_AUDIT_FORM_ENDPOINT=

# Site key de Cloudflare Turnstile (anti-spam). Opcional; si se define se carga el widget.
PUBLIC_TURNSTILE_SITE_KEY=
