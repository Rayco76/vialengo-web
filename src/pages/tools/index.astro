---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { href } from '../../lib/url';
---
<!-- Ruta reservada para futuras herramientas de diagnóstico. Fuera de navegación, sitemap y llms.txt. -->
<BaseLayout title="Herramientas" description="Herramientas de diagnóstico de Vialengo." path="/tools/" noindex>
  <main id="contenido">
    <PageHeader eyebrow="Herramientas" title="Aún no hay herramientas publicadas." intro="Mientras tanto, la forma más directa de saber dónde mejorar es la auditoría inicial." />
    <div class="container prose"><p><a href={href('/services/')}>Ver los servicios</a></p></div>
    <CtaBand />
  </main>
</BaseLayout>
