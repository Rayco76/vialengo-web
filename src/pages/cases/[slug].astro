---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseGallery from '../../components/CaseGallery.astro';
import { cases } from '../../content/cases';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
---
<BaseLayout title={c.title} description={c.summary} path={`/cases/${c.slug}/`}>
  <main id="contenido">
    <PageHeader eyebrow={c.title} title={c.headline ?? c.title} intro={c.summary} />
    {c.initialSituation && <section class="section" aria-labelledby="situacion-title">
      <div class="container service-layout">
        <div><p class="eyebrow">El punto de partida</p><h2 id="situacion-title">Situación inicial</h2></div>
        <p class="section-intro">{c.initialSituation}</p>
      </div>
    </section>}
    <section class="section alt" aria-labelledby="alcance-title">
      <div class="container service-layout">
        <div>
          <p class="eyebrow">El trabajo</p>
          <h2 id="alcance-title">{c.initialSituation ? 'Qué construimos' : 'Qué se está implantando'}</h2>
          <p class="section-intro">Estado: {c.status === 'in-progress' ? 'piloto en curso' : 'publicado'}.</p>
        </div>
        <ul class="check-list">{c.scope.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>
    {c.gallery?.length && <section class="section" aria-labelledby="galeria-title">
      <div class="container">
        <p class="eyebrow">El proceso, a la vista</p><h2 id="galeria-title">Galería de trabajo</h2>
        <p class="section-intro">Aquí mostraremos materiales reales aprobados para compartir. Los espacios pendientes están señalados como «Próximamente».</p>
        <CaseGallery items={c.gallery} />
      </div>
    </section>}
    <section class="section alt" aria-labelledby="resultados-title">
      <div class="container service-layout">
        <div><p class="eyebrow">Lo que sabemos hasta ahora</p><h2 id="resultados-title">{c.initialSignals ? 'Primeras señales' : 'Resultados'}</h2></div>
        <div>
          {c.initialSignals ? <>
            <p class="section-intro signal-summary">{c.initialSignals.summary}</p>
            <p class="signal-source">{c.initialSignals.source}</p>
            <p class="note">{c.initialSignals.note}</p>
          </> : c.metrics.length ? <div class="metric-grid metric-grid-page">{c.metrics.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div> : <p class="section-intro">Todavía no publicamos resultados: esperamos a tener datos reales y verificados.</p>}
        </div>
      </div>
    </section>
    {c.nextSteps && <section class="section" aria-labelledby="proximos-title">
      <div class="container service-layout">
        <h2 id="proximos-title">Próximos pasos</h2><p class="section-intro">{c.nextSteps}</p>
      </div>
    </section>}
    <div class="container case-footnote">
      {c.publicationNote && <p>{c.publicationNote}</p>}
      <a class="text-link" href={href('/cases/')}>← Todos los casos</a>
    </div>
    <CtaBand title="¿Quieres ordenar la presencia digital de tu negocio?" text="Cuéntanos en qué punto estás y valoramos por dónde empezar." />
  </main>
</BaseLayout>
