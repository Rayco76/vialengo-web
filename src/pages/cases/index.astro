---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { cases } from '../../content/cases';
import { href } from '../../lib/url';
---
<BaseLayout title="Casos" description="Estado del primer proyecto de Vialengo. Todavía no publicamos resultados: solo datos verificados." path="/cases/" schemaType="CollectionPage">
  <main id="contenido">
    <PageHeader eyebrow="Casos" title="Primer proyecto en implementación." intro="Todavía no hay resultados que publicar. Cuando los haya, aparecerán aquí con datos verificados y sin cifras de relleno." />
    <section class="section" aria-label="Proyectos">
      <div class="container case-list">
        {cases.map((c) => (
          <article class="case-item">
            <span class="case-label">{c.status === 'in-progress' ? 'En implementación' : 'Publicado'} · {c.sector}</span>
            <h2><a href={href(`/cases/${c.slug}/`)}>{c.title}</a></h2>
            <p>{c.summary}</p>
          </article>
        ))}
      </div>
    </section>
    <CtaBand />
  </main>
</BaseLayout>
