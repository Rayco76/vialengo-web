---
import { faqs } from '../content/faqs';
const items = faqs.filter((f) => f.home);
---
<section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div><p class="eyebrow">FAQ</p><h2 id="faq-title">Preguntas habituales</h2></div><div>{items.map((f) => <details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div></div></section>
