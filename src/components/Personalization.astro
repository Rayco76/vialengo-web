---
import Icon from './Icon.astro';
const axes = ['Qué llevamos por ti', 'Qué material necesitamos', 'Qué apruebas tú', 'Con qué frecuencia', 'Qué herramientas usamos', 'Cómo revisamos el trabajo'];
---
<section class="section personal-section" aria-labelledby="personal-title">
  <div class="container personal-layout">
    <div>
      <p class="eyebrow">A medida</p>
      <h2 id="personal-title">Un servicio a tu medida.<br />Y alguien al otro lado.</h2>
      <p class="section-intro">Hablamos contigo, acordamos las prioridades y nos ocupamos del trabajo definido. Tendrás claro qué llevamos nosotros, qué necesita tu revisión y cómo seguimos avanzando.</p>
    </div>
    <ul class="axes" aria-label="El servicio se adapta a">
      {axes.map((axis) => <li><Icon name="Check" size={18} />{axis}</li>)}
    </ul>
  </div>
</section>
