---
const problems = [
  ['Consultas que llegan y no terminan en cita', 'WhatsApp, teléfono, formularios y mensajes que se enfrían antes de reservar.'],
  ['Pacientes que escriben fuera de horario', 'Una oportunidad puede aparecer cuando recepción ya está cerrada.'],
  ['Seguimiento manual', 'Recordatorios, reseñas, reactivación y seguimiento consumen tiempo del equipo.'],
  ['Marketing sin una medición clara', 'La clínica invierte en diferentes canales pero no sabe cuáles generan realmente citas.'],
];
---
<section class="section problem-section" aria-labelledby="problema-title">
  <div class="container"><p class="eyebrow">El problema</p><h2 id="problema-title">No siempre hacen falta más leads.<br />Muchas veces hay que perder menos.</h2>
    <div class="problem-grid">{problems.map(([title, text], index) => <article class="problem-card"><span class="card-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
  </div>
</section>
