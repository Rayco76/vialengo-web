---
import { verticals } from '../content/verticals';
import { href } from '../lib/url';
---
<section class="section verticals-section" id="sectores" aria-labelledby="verticals-title">
  <div class="container">
    <p class="eyebrow">Sectores</p>
    <h2 id="verticals-title">Especializados donde hay cita previa.</h2>
    <p class="section-intro">Empezamos por clínicas dentales y la arquitectura está preparada para adaptarse a otros negocios con agenda.</p>
    <ul class="verticals-grid">
      {verticals.map((v) => (
        <li class:list={['vertical-card', { active: v.status === 'active' }]}>
          <h3>{v.page ? <a href={href(`/sectores/${v.slug}/`)}>{v.name}</a> : v.name}</h3>
          <p>{v.summary}</p>
          <span class="vertical-status">{v.status === 'active' ? 'Primer sector' : 'En el horizonte'}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
