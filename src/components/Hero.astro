---
import Icon from './Icon.astro';
import { solutions } from '../content/solutions';
import { href } from '../lib/url';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Tu negocio local, acompañado en lo digital</p>
      <h1 id="hero-title">Nos encargamos de la parte <span>digital de tu negocio.</span></h1>
      <p class="lead">Web, redes sociales, Google, reseñas y atención por WhatsApp. Nos ocupamos de ponerlo en marcha y mantenerlo al día, con un mismo contacto para coordinarlo.</p>
      <div class="hero-actions">
        <a class="button" data-track-cta href="#auditoria">Cuéntanos qué necesitas <Icon name="ArrowRight" size={17} /></a>
        <a class="text-link" href="#soluciones">Ver servicios</a>
      </div>
      <p class="hero-note">Empezamos por lo que necesitas. Seguimos contigo para mejorarlo.</p>
    </div>
    <aside class="digital-overview" aria-labelledby="overview-title">
      <div class="overview-heading">
        <img src={href('/brand/vialengo-symbol-on-dark.svg')} alt="" width="45" height="36" />
        <div><p class="eyebrow">Vialengo se encarga</p><h2 id="overview-title">Tu parte digital,<br />en buenas manos.</h2></div>
      </div>
      <ul class="overview-services">
        {solutions.map((service) => <li><a href={href('/services/#' + service.id)}><Icon name={service.icon} size={22} /><span>{service.title}</span></a></li>)}
      </ul>
      <p class="overview-note"><span aria-hidden="true"></span>Un mismo contacto. Un plan adaptado a ti.</p>
    </aside>
  </div>
</section>
