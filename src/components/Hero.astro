---
import Icon from './Icon.astro';
import { href } from '../lib/url';

// Flujo de ejemplo fiel a lo que hace el sistema hoy: el asistente recoge la solicitud y
// recepción propone el horario. No mostrar aquí nada que todavía no exista.
const flow = [
  { icon: 'MessageCircle', title: 'Mensaje recibido', text: '«¿Tenéis hueco el jueves por la tarde?»' },
  { icon: 'CalendarCheck', title: 'Solicitud de cita', text: 'Clasificada, con los datos ya recogidos.' },
  { icon: 'Users', title: 'Recepción', text: 'Propone el horario y confirma la cita.' },
] as const;
const system = [
  { icon: 'Search', label: 'Google' },
  { icon: 'Globe', label: 'Web' },
  { icon: 'Share2', label: 'Redes' },
  { icon: 'MessageCircle', label: 'WhatsApp' },
  { icon: 'CalendarCheck', label: 'Agenda' },
  { icon: 'Users', label: 'Cliente' },
  { icon: 'Star', label: 'Reseña' },
] as const;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Presencia digital y atención para negocios locales</p>
      <h1 id="hero-title">Tecnología que hace crecer tu negocio.</h1>
      <p class="lead">Conectamos tu web, Google, redes sociales, WhatsApp, agenda y reseñas para que tu negocio fluya mejor. Mantenemos tu presencia online al día y respondemos automáticamente las preguntas más frecuentes de tus clientes.</p>
      <div class="hero-actions">
        <a class="button" data-track-cta href="#auditoria">Solicitar auditoría</a>
        <a class="text-link" href={href('/services/')}>Ver soluciones <Icon name="ArrowRight" size={16} /></a>
      </div>
    </div>
    <figure class="hero-panel" aria-label="Ilustración: una consulta por WhatsApp se convierte en una solicitud de cita">
      <ol class="flow">
        {flow.map((step) => (
          <li><span class="flow-icon"><Icon name={step.icon} size={18} /></span><div><strong>{step.title}</strong><span>{step.text}</span></div></li>
        ))}
      </ol>
      <figcaption>Ilustración orientativa de cómo avanza una consulta.</figcaption>
    </figure>
  </div>
  <div class="container">
    <ol class="system-strip" aria-label="Las partes que Vialengo conecta">
      {system.map((node) => <li><span class="flow-icon"><Icon name={node.icon} size={18} /></span>{node.label}</li>)}
    </ol>
  </div>
</section>
