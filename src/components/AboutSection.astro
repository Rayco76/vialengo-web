---
import MediaFrame from './MediaFrame.astro';
import { founder } from '../content/about';
---
<section class="section about-section" id="sobre-vialengo" aria-labelledby="about-title">
  <div class="container about-layout">
    <figure class="founder-portrait">
      <MediaFrame src={founder.photo.src} alt={founder.photo.alt} label="Fotografía profesional pendiente" portrait />
      <figcaption>{founder.name} · {founder.role}</figcaption>
    </figure>
    <div>
      <p class="eyebrow">Sobre Vialengo</p>
      <h2 id="about-title">{founder.title}</h2>
      {founder.paragraphs.map((paragraph) => <p class="section-intro">{paragraph}</p>)}
      <p class="founder-signature"><strong>{founder.name}</strong><span>{founder.role}</span></p>
    </div>
  </div>
</section>
