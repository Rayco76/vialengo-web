---
import { legalComplete, siteConfig } from '../config/site';
import PageHeader from './PageHeader.astro';

interface Props { title: string; intro: string; }
const { title, intro } = Astro.props;
const { legal } = siteConfig;
// Datos del titular. Los que faltan se marcan visiblemente en lugar de inventarlos.
const holder: [string, string | null][] = [
  ['Titular (nombre o razón social)', legal.holderName],
  ['NIF/CIF', legal.taxId],
  ['Domicilio', legal.address],
  ['Datos registrales (si procede)', legal.registry],
  ['Email de contacto', legal.contactEmail],
];
---
<PageHeader eyebrow="Legal" title={title} intro={intro} />
<div class="container prose">
  {!legalComplete && (
    <aside class="draft-banner" role="note">
      <strong>Borrador pendiente de completar.</strong> Este documento no es todavía el texto legal definitivo: faltan datos del titular y su revisión jurídica.
    </aside>
  )}
  <section aria-labelledby="titular">
    <h2 id="titular">Datos del titular</h2>
    <dl class="holder-data">
      {holder.map(([label, value]) => (
        <><dt>{label}</dt><dd>{value ?? <mark>Pendiente: lo debe aportar el titular</mark>}</dd></>
      ))}
    </dl>
  </section>
  <slot />
</div>
