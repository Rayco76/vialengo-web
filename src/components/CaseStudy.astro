import { caseMetrics } from '../config/metrics';
---
<section class="section case-section" aria-labelledby="case-title"><div class="container case-layout"><div><p class="eyebrow">Resultados</p><h2 id="case-title">El sistema se valida en el día a día.</h2><p class="section-intro">Estamos desplegando Clinic Growth OS en una clínica real y midiendo el impacto sobre conversaciones, citas, actividad fuera de horario y conversión.</p></div><div class="case-card">{caseMetrics.length ? <div class="metric-grid">{caseMetrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div> : <><span class="case-label">Caso en curso</span><h3>Primer caso en implementación</h3><p>Pronto sustituiremos este espacio con datos verificables, sin métricas de relleno.</p><div class="case-progress"><i></i></div></>}</div></div></section>
